generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  hashedPassword  String
  image     String?
  role      String
  createdAt DateTime   @default(now())
  landlords Landlord[]
  tenants   Tenant[]
  @@map("user")
}

model Landlord {
  id          String     @id @default(uuid())
  userId      String
  companyName String
  user        User       @relation(fields: [userId], references: [id])
  properties  Property[]
  @@map("landlord")
}

model Tenant {
  id               String    @id @default(uuid())
  userId           String
  propertyId       String
  moveInDate       DateTime
  unitOccupied     String
  emergencyContact String
  user             User       @relation(fields: [userId], references: [id])
  property         Property  @relation(fields: [propertyId], references: [id])
  invoices         Invoice[]
  @@map("tenant")
}

model Property {
  id         String   @id @default(uuid())
  address    String
  totalUnits Int
  landlordId String
  landlord   Landlord @relation(fields: [landlordId], references: [id])
  units      Unit[]
  tenants    Tenant[]
  @@map("property")
}

model Unit {
  id          String        @id @default(uuid())
  propertyId  String
  unitNumber  String
  status      String
  property    Property      @relation(fields: [propertyId], references: [id])
  maintenances Maintenance[]
  @@map("unit")
}

model Maintenance {
  id          String   @id @default(uuid())
  unitId      String
  description String
  date        DateTime
  status      String
  unit        Unit     @relation(fields: [unitId], references: [id])
  @@map("maintenance")
}

model Invoice {
  id       String   @id @default(uuid())
  tenantId String
  amount   Int
  date     DateTime
  status   String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  @@map("invoice")
}

model Revenue {
  id      String @id @default(uuid())
  month   String
  revenue Int
  @@map("revenue")
}

